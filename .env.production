# MCAS-Life Production Environment Configuration
# Copy this to .env.prod and fill in secure values

# App Configuration
APP_VERSION=1.0.0
NODE_ENV=production
FRONTEND_URL=https://mcas-life.app

# Database Configuration
POSTGRES_PASSWORD=your_secure_postgres_password_here
DATABASE_URL=postgresql://mcas:${POSTGRES_PASSWORD}@postgres:5432/mcas_life

# Redis Configuration
REDIS_PASSWORD=your_secure_redis_password_here
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379

# JWT Configuration (Generate with: openssl rand -base64 32)
JWT_SECRET=your_secure_jwt_secret_here_32_chars_minimum
JWT_REFRESH_SECRET=your_secure_refresh_secret_here_32_chars

# Monitoring (optional)
GRAFANA_PASSWORD=your_secure_grafana_password_here

# Email Configuration (for notifications)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@mcas-life.app
SMTP_PASSWORD=your_smtp_password_here

# External API Keys (optional)
OPENAI_API_KEY=your_openai_api_key_for_ai_features
SENTRY_DSN=your_sentry_dsn_for_error_tracking

# SSL Configuration (if using Let's Encrypt)
LETSENCRYPT_EMAIL=admin@mcas-life.app
DOMAIN_NAME=mcas-life.app

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info