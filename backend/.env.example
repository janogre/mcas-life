# MCAS-Life Backend Environment Configuration

# Database Configuration
DATABASE_URL=postgresql://mcas_user:mcas_password@localhost:5432/mcas_life
DATABASE_MAX_CONNECTIONS=10
DATABASE_IDLE_TIMEOUT=30

# Server Configuration
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
FRONTEND_URL=http://localhost:3000

# Authentication & Security
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
BCRYPT_ROUNDS=12
SESSION_SECRET=change-this-session-secret-in-production

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# External API Integration
OPENAI_API_KEY=your-openai-api-key-for-recipe-generation
SPOONACULAR_API_KEY=your-spoonacular-api-key-here
FOODDATA_API_URL=https://www.fooddata.dk/api
OPENFOODFACTS_API_URL=https://world.openfoodfacts.org/api/v0

# Email Configuration (for notifications)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@mcaslife.no
SMTP_PASS=your-smtp-password
FROM_EMAIL=MCAS-Life <noreply@mcaslife.no>

# Feature Flags
ENABLE_AI_CORRELATION=true
ENABLE_VOICE_INPUT=false
ENABLE_PHOTO_RECOGNITION=false
ENABLE_EXPERT_NETWORK=false
ENABLE_RESEARCH_PARTICIPATION=true

# Development Settings
LOG_LEVEL=debug
ENABLE_SWAGGER=true
ENABLE_DRIZZLE_STUDIO=true
