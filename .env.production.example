# MCAS-Life Production Environment Configuration
# Copy this file to .env.production and fill in your values

# ============================================
# DOMAIN CONFIGURATION
# ============================================
# Your domain name (will be used for Traefik routing and CORS)
DOMAIN=mcas.yourdomain.com

# ============================================
# DATABASE CONFIGURATION
# ============================================
# PostgreSQL password (generate a strong password)
DB_PASSWORD=change_this_to_a_strong_password

# ============================================
# REDIS CONFIGURATION
# ============================================
# Redis password (generate a strong password)
REDIS_PASSWORD=change_this_to_a_strong_password

# ============================================
# JWT SECRETS
# ============================================
# Generate strong random secrets for JWT tokens
# You can generate these with: openssl rand -base64 32
JWT_SECRET=change_this_to_a_long_random_secret
JWT_REFRESH_SECRET=change_this_to_another_long_random_secret

# ============================================
# AIRTHINGS INTEGRATION (OPTIONAL)
# ============================================
# Leave empty if you don't use Airthings integration
AIRTHINGS_CLIENT_ID=
AIRTHINGS_CLIENT_SECRET=
AIRTHINGS_REDIRECT_URI=

# ============================================
# BACKUP CONFIGURATION (OPTIONAL)
# ============================================
# If you want automatic database backups
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM
